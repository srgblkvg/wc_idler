{
  "name": "iriy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev -w @azeroth/server\" \"npm run dev -w @azeroth/web\"",
    "build": "npm run build -w @azeroth/web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "npm run db:migrate -w @azeroth/server",
    "format": "prettier --write apps packages tests *.json *.md .github/workflows/*.yml",
    "db:cleanup": "npm run db:cleanup -w @azeroth/server",
    "preview": "npm run build && node scripts/preview.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.9",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "shell-quote": "^1.12.0"
  }
}
